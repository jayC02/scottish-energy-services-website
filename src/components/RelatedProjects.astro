---
import { projectsForService } from '../data/project-cases';
import ProjectCard from './ProjectCard.astro';
const { slug } = Astro.props as { slug: string };
const related = projectsForService(slug);
---
{related.length > 0 && <section class="section related-projects"><div class="container">
  <div class="related-heading"><h2>Our work</h2><a href="/projects">All projects <span aria-hidden="true">↗</span></a></div>
  <div class="related-grid">{related.map(project => <ProjectCard project={project} compact />)}</div>
</div></section>}
<style>
  .related-projects{background:var(--surface-soft)}.related-heading{display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-bottom:1.2rem}
  h2{margin:0;font-size:1.6rem;line-height:1.2;color:var(--text-strong)}.related-heading>a{font-size:.85rem;color:var(--brand-strong)}
  .related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}@media(max-width:800px){.related-grid{grid-template-columns:1fr}}
</style>
