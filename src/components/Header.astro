---
import { siteConfig } from "../data/site";
import { services } from "../data/services";
const { minimal = false } = Astro.props;
const links = [
  ["/sectors", "Sectors"],
  ["/projects", "Projects"],
  ["/about", "About"],
  ["/insights", "Insights"],
  ["/contact", "Contact"],
];
---

<header class="site-header" data-header>
  <div class="container nav-wrap">
    <a href="/" class="brand" aria-label="Scottish Energy Services home">
      <img
        src="/images/ses-logo-horizontal.png"
        alt="Scottish Energy Services"
        width="270"
        height="76"
        fetchpriority="high"
      />
    </a>
    {!minimal && (
      <details class="navigation" data-navigation open>
        <summary class="menu-toggle">
          Menu <span aria-hidden="true">☰</span>
        </summary>
        <nav aria-label="Primary navigation">
          <ul>
            <li>
              <details class="services-menu">
                <summary>
                  Services <span aria-hidden="true">⌄</span>
                </summary>
                <div class="service-dropdown">
                  <a href="/services">All services →</a>
                  {services
                    .filter((s) => s.slug !== "domestic-epcs-and-legionellas")
                    .map((s) => (
                      <a href={`/services/${s.slug}`}>{s.title}</a>
                    ))}
                </div>
              </details>
            </li>
            {links.map(([href, label]) => (
              <li>
                <a
                  href={href}
                  aria-current={
                    Astro.url.pathname === href ? "page" : undefined
                  }
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    )}
    <div class="nav-actions">
      <a href={`tel:${siteConfig.phone.replaceAll(" ", "")}`} class="nav-phone">
        {siteConfig.phone}
      </a>
      <a
        class="btn btn-primary"
        href={minimal ? "#enquire" : "/quote"}
        data-track="primary_cta_clicked"
      >
        Request a quote <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</header>
<!-- Run before main content is parsed: no mobile layout shift; native open menu remains available without JS. -->
<script is:inline>
  if (window.matchMedia("(max-width: 960px)").matches) {
    const navigation = document.querySelector("[data-navigation]");
    if (navigation) navigation.open = false;
  }
</script>
<style>
  .site-header {
    position: sticky;
    top: 0;
    background: #fffffff7;
    border-bottom: 1px solid var(--border);
    z-index: 100;
  }
  .nav-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 96px;
  }
  .brand {
    flex-shrink: 0;
    width: 215px;
  }
  .brand img {
    width: 100%;
    height: auto;
  }
  .navigation {
    border: 0;
    padding: 0;
  }
  .menu-toggle {
    display: none;
  }
  .navigation:not([open]) > nav {
    display: block;
  }
  .navigation nav > ul {
    display: flex;
    align-items: center;
    gap: 1.3rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.8rem;
  }
  .navigation a[aria-current] {
    color: var(--brand);
    text-decoration: underline;
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }
  .nav-phone {
    font-size: 0.8rem;
    white-space: nowrap;
    font-weight: 600;
  }
  .nav-actions .btn {
    padding: 0.8rem 1rem;
    font-size: 0.78rem;
  }
  .services-menu {
    border: 0;
    padding: 1.8rem 0;
  }
  .services-menu > summary {
    list-style: none;
    font-weight: 400;
  }
  .services-menu > summary::-webkit-details-marker {
    display: none;
  }
  .service-dropdown {
    position: absolute;
    top: 80px;
    background: white;
    border: 1px solid var(--border);
    padding: 1.2rem;
    display: grid;
    gap: 0.5rem;
    max-width: 350px;
    box-shadow: var(--shadow);
  }
  .service-dropdown a {
    padding: 0.4rem;
  }
  .service-dropdown a:hover {
    background: var(--bg);
  }
  @media (max-width: 1200px) {
    .nav-phone {
      display: none;
    }
    .navigation nav > ul {
      gap: 1rem;
    }
    .brand {
      width: 185px;
    }
  }
  @media (max-width: 960px) {
    .nav-wrap {
      min-height: 80px;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .brand {
      width: 180px;
    }
    .navigation {
      order: 3;
      width: 100%;
    }
    .menu-toggle {
      display: flex;
      position: absolute;
      right: 20px;
      top: 22px;
      gap: 0.7rem;
      font-size: 0.9rem;
      align-items: center;
      min-height: 40px;
    }
    .nav-actions {
      margin-left: auto;
      margin-right: 85px;
    }
    .nav-actions .btn {
      min-height: 40px;
      padding: 0.6rem 0.8rem;
    }
    .navigation:not([open]) > nav {
      display: none;
    }
    .navigation nav > ul {
      display: block;
      padding-bottom: 1rem;
    }
    .navigation nav > ul > li > a {
      display: block;
      padding: 0.8rem 0;
      border-bottom: 1px solid var(--border);
    }
    .services-menu {
      padding: 0.8rem 0;
    }
    .service-dropdown {
      position: static;
      box-shadow: none;
      max-width: none;
      margin-top: 1rem;
    }
    .navigation[open] {
      max-height: calc(100dvh - 100px);
      overflow-y: auto;
    }
    .nav-wrap:has(.navigation[open]) {
      padding-bottom: 1rem;
    }
  }
  @media (max-width: 600px) {
    .nav-actions {
      display: none;
    }
    .brand {
      width: 190px;
    }
    .nav-wrap {
      flex-wrap: nowrap;
    }
    .navigation {
      width: 0;
    }
    .navigation[open] {
      width: 100%;
      order: 3;
    }
    .nav-wrap:has(.navigation[open]) {
      flex-wrap: wrap;
    }
    .menu-toggle {
      top: 20px;
    }
  }
  @media (max-width: 430px) {
    .brand {
      width: 145px;
    }
    .nav-actions .btn {
      font-size: 0.7rem;
      gap: 0.3rem;
    }
    .nav-actions {
      margin-right: 68px;
    }
    .menu-toggle {
      font-size: 0.75rem;
      gap: 0.3rem;
    }
  }
</style>
