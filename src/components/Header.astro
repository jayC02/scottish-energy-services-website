---
import { navItems, siteConfig, turnaroundPromise } from '../data/site';
import { services, serviceCategories, turnaroundOf } from '../data/services';
import { caseStudies } from '../data/project-cases';
import { projectImages } from '../data/project-images';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const phoneHref = `tel:${siteConfig.phone.replace(/\s+/g, '')}`;
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`);

const featuredSlugs = ['glasgow-airport', 'sec-armadillo', 'university-of-edinburgh', 'theatre-royal-glasgow'];
const featured = featuredSlugs
  .map(slug => caseStudies.find(project => project.slug === slug))
  .filter((project): project is NonNullable<typeof project> => Boolean(project && projectImages[project.slug]));

type DropLink = { label: string; text: string; href: string };
const dropdowns: Record<string, DropLink[]> = {
  '/about': [
    { label: 'About SES', text: 'Who we are and how we work', href: '/about' },
    { label: 'Areas we cover', text: 'All of Scotland and the north of England', href: '/areas' }
  ]
};
const menuId = (href: string) => `menu-${href.replace(/\W+/g, '') || 'home'}`;
---
<header class="sticky" data-header>
  <div class="container nav-wrap">
    <a href="/" class="brand" aria-label="Scottish Energy Services home">
      <img src="/images/ses-logo-horizontal.png" alt="Scottish Energy Services" loading="eager" decoding="async" />
    </a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav id="site-nav" class="nav" aria-label="Primary navigation">
      <ul class="nav-list">
        {navItems.map((item) => {
          const hasMega = item.href === '/services' || item.href === '/projects';
          const drop = dropdowns[item.href];
          const hasMenu = hasMega || Boolean(drop);
          const id = menuId(item.href);
          return (
            <li class:list={['nav-item', { 'has-menu': hasMenu, 'has-mega': hasMega }]} data-menu={hasMenu ? '' : undefined}>
              <div class="nav-row">
                <a class:list={['nav-link', { active: isActive(item.href) }]} href={item.href} aria-current={pathname === item.href ? 'page' : undefined}>{item.label}</a>
                {hasMenu && <button class="nav-caret" type="button" aria-expanded="false" aria-controls={id} data-menu-toggle>
                  <span class="sr-only">Show {item.label} menu</span>
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="m2.5 4.5 3.5 3.5 3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>}
              </div>

              {item.href === '/services' && <div class="submenu submenu--mega" id={id}>
                <div class="submenu__inner">
                  <div class="container mega">
                    <div class="mega__promo">
                      <p class="mega__eyebrow">Our services</p>
                      <p class="mega__title">Reports within {turnaroundPromise.hours} hours of our visit.</p>
                      <p class="mega__text">Every service is turned around within {turnaroundPromise.hours} hours, and Domestic EPCs and Legionella the same day.</p>
                      <a class="mega__cta" href="/services">View all services <span aria-hidden="true">→</span></a>
                    </div>
                    {serviceCategories.map((category, col) => (
                      <div class="mega__col" style={`--i:${col}`}>
                        <p class="mega__heading">{category.label}</p>
                        <ul>
                          {services.filter(service => service.category === category.id).map((service, row) => (
                            <li style={`--j:${row}`}>
                              <a class="mega__link" href={`/services/${service.slug}`}>
                                <strong>{service.title} <span aria-hidden="true">→</span></strong>
                                <span class="mega__desc">{service.short}</span>
                                {service.sameDay && <span class="mega__flag">{turnaroundOf(service).label}</span>}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </div>}

              {item.href === '/projects' && <div class="submenu submenu--mega" id={id}>
                <div class="submenu__inner">
                  <div class="container mega mega--projects">
                    <div class="mega__promo">
                      <p class="mega__eyebrow">Our work</p>
                      <p class="mega__title">Trusted on some of Scotland’s best-known buildings.</p>
                      <p class="mega__text">Airports, universities, venues, hotels and retail across Scotland and the north of England.</p>
                      <a class="mega__cta" href="/projects">View all {caseStudies.length} projects <span aria-hidden="true">→</span></a>
                    </div>
                    <ul class="mega__projects">
                      {featured.map((project, index) => {
                        const image = projectImages[project.slug];
                        return (
                          <li style={`--i:${index}`}>
                            <a class="mega__project" href={`/projects/${project.slug}`}>
                              <span class="mega__thumb"><img src={image.small || image.src} alt="" width="320" height="200" loading="lazy" decoding="async" style={`object-position: ${image.position || '50% 50%'}`} /></span>
                              <strong>{project.label}</strong>
                              <span>{project.sector} · {project.location}</span>
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                </div>
              </div>}

              {drop && <div class="submenu submenu--drop" id={id}>
                <div class="submenu__inner">
                  <ul class="drop">
                    {drop.map((link, index) => (
                      <li style={`--j:${index}`}>
                        <a class="drop__link" href={link.href}><strong>{link.label}</strong><span>{link.text}</span></a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>}
            </li>
          );
        })}
      </ul>
      <a href={phoneHref} class="nav-phone">{siteConfig.phone}</a>
      <a href="/quote" class="btn btn-primary">Get a Quote</a>
    </nav>
  </div>
</header>

<script>
  const items = [...document.querySelectorAll<HTMLElement>('[data-menu]')];
  const desktop = window.matchMedia('(min-width: 941px)');

  const setOpen = (item: HTMLElement, open: boolean) => {
    item.classList.toggle('is-open', open);
    item.querySelector('[data-menu-toggle]')?.setAttribute('aria-expanded', String(open));
  };
  const closeAll = (except?: HTMLElement) => items.forEach(item => { if (item !== except) { setOpen(item, false); item.classList.remove('is-suppressed'); } });

  items.forEach(item => {
    const toggle = item.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    let hoverTimer = 0;

    toggle?.addEventListener('click', () => {
      const open = !item.classList.contains('is-open');
      closeAll(item);
      item.classList.remove('is-suppressed');
      setOpen(item, open);
    });

    // Hover intent: a short delay stops menus flashing open as the pointer crosses the bar.
    item.addEventListener('pointerenter', (event) => {
      if (!desktop.matches || event.pointerType === 'touch') return;
      window.clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => { closeAll(item); item.classList.remove('is-suppressed'); setOpen(item, true); }, 70);
    });
    item.addEventListener('pointerleave', (event) => {
      if (!desktop.matches || event.pointerType === 'touch') return;
      window.clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => { setOpen(item, false); item.classList.remove('is-suppressed'); }, 160);
    });

    item.addEventListener('focusout', (event) => {
      if (desktop.matches && !item.contains(event.relatedTarget as Node | null)) { setOpen(item, false); item.classList.remove('is-suppressed'); }
    });

    item.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !item.matches('.is-open, :focus-within')) return;
      setOpen(item, false);
      item.classList.add('is-suppressed');
      toggle?.focus();
      event.stopPropagation();
    });
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node) || !items.some(item => item.contains(event.target as Node))) closeAll();
  });
  desktop.addEventListener('change', () => closeAll());
</script>

<style>
  .nav-wrap { display: flex; align-items: center; justify-content: space-between; min-height: 84px; gap: 1rem; }
  .brand { display: inline-flex; align-items: center; max-width: 270px; }
  .brand img { width: 100%; height: auto; }
  .nav { display: flex; align-items: center; gap: 1rem; }
  .nav-list { display: flex; list-style: none; gap: .35rem; margin: 0; padding: 0; }
  .nav-row { display: flex; align-items: center; }
  .nav-link {
    color: var(--muted);
    font-weight: 500;
    border-radius: 999px;
    padding: .34rem .72rem;
    transition: background-color .2s ease, color .2s ease;
  }
  .nav-link.active, .nav-link:hover { color: var(--text-strong); background: color-mix(in oklab, var(--surface) 64%, var(--brand-soft)); }
  .has-menu .nav-link { padding-right: .2rem; border-radius: 999px 0 0 999px; }
  .nav-caret { display: grid; place-items: center; width: 24px; height: 32px; margin-left: -2px; padding: 0 .35rem 0 0; border: 0; border-radius: 0 999px 999px 0; background: transparent; color: var(--muted); cursor: pointer; transition: color .2s ease, background-color .2s ease; }
  .nav-caret svg { transition: transform .35s var(--ease-out); }
  .has-menu:is(.is-open, :hover) .nav-caret { color: var(--brand-strong); }
  .has-menu.is-open .nav-caret svg { transform: rotate(180deg); }
  .has-menu .nav-link.active + .nav-caret { background: color-mix(in oklab, var(--surface) 64%, var(--brand-soft)); color: var(--text-strong); }
  .nav-phone { color: var(--brand-strong); font-weight: 700; font-size: .93rem; border-left: 1px solid var(--border); padding-left: .95rem; }
  .menu-toggle { display: none; }

  /* ---------- Desktop menus ---------- */
  @media (min-width: 941px) {
    .sticky:has(.has-mega.is-open:not(.is-suppressed)) { background: #fff; }
    .nav-item { position: relative; }
    .nav-item.has-mega { position: static; }

    .submenu {
      position: absolute;
      z-index: 20;
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
      transition: opacity .22s ease, transform .38s var(--ease-out), visibility 0s linear .38s;
    }
    .submenu--mega { left: 0; right: 0; top: 100%; transform: translateY(-8px); }
    .submenu--drop { left: 50%; top: calc(100% + 24px); min-width: 290px; transform: translate(-50%, -8px); }
    /* Invisible bridge so the pointer can travel from the link to the panel. */
    .submenu::before { content: ''; position: absolute; left: 0; right: 0; bottom: 100%; height: 26px; }

    .has-menu.is-open:not(.is-suppressed) > .submenu,
    .has-menu:has(:focus-visible):not(.is-suppressed) > .submenu {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      transition: opacity .25s ease, transform .45s var(--ease-out), visibility 0s;
    }
    .has-menu.is-open:not(.is-suppressed) > .submenu--mega,
    .has-menu:has(:focus-visible):not(.is-suppressed) > .submenu--mega { transform: none; }
    .has-menu.is-open:not(.is-suppressed) > .submenu--drop,
    .has-menu:has(:focus-visible):not(.is-suppressed) > .submenu--drop { transform: translate(-50%, 0); }
    .has-menu:has(:focus-visible):not(.is-suppressed) .nav-caret svg { transform: rotate(180deg); }

    /* Mega panel: full width, reveals downward */
    .submenu--mega .submenu__inner { background: #fff; border-top: 1px solid var(--border); box-shadow: 0 40px 60px -30px rgba(10, 34, 56, .35); clip-path: inset(0 0 100% 0); transition: clip-path .5s cubic-bezier(.77, 0, .18, 1); }
    .has-menu.is-open:not(.is-suppressed) > .submenu--mega .submenu__inner,
    .has-menu:has(:focus-visible):not(.is-suppressed) > .submenu--mega .submenu__inner { clip-path: inset(0 0 -80px 0); }

    .mega { display: grid; grid-template-columns: minmax(250px, 1fr) repeat(3, minmax(0, 1fr)); gap: 2rem; padding: 2rem 0 2.2rem; }
    .mega--projects { grid-template-columns: minmax(250px, 1fr) 3fr; }
    .mega__promo { display: flex; flex-direction: column; padding: 1.5rem; border-radius: 6px; background: linear-gradient(140deg, var(--navy), var(--navy-2)); color: #fff; }
    .mega__eyebrow { margin: 0 0 .7rem; color: var(--mint); font-size: .7rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
    .mega__title { margin: 0; font-size: 1.3rem; font-weight: 800; line-height: 1.15; letter-spacing: -.03em; }
    .mega__text { margin: .7rem 0 1.2rem; color: #b9cad8; font-size: .86rem; line-height: 1.55; }
    .mega__cta { display: inline-flex; gap: .45rem; margin-top: auto; color: #fff; font-size: .88rem; font-weight: 750; }
    .mega__cta span { color: var(--mint); transition: transform .3s var(--ease-out); }
    .mega__cta:hover span { transform: translateX(4px); }

    .mega__heading { margin: .4rem 0 .9rem; padding-bottom: .7rem; border-bottom: 1px solid var(--border); color: var(--mint-strong); font-size: .7rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
    .mega__col ul, .mega__projects, .drop { margin: 0; padding: 0; list-style: none; }
    .mega__link { display: block; margin: 0 -.75rem; padding: .6rem .75rem; border-radius: 6px; transition: background-color .2s ease; }
    .mega__link strong { display: flex; justify-content: space-between; gap: .5rem; color: var(--navy); font-size: .93rem; font-weight: 750; }
    .mega__link strong span { color: var(--brand); opacity: 0; transform: translateX(-6px); transition: opacity .25s ease, transform .3s var(--ease-out); }
    .mega__desc { display: -webkit-box; margin-top: .15rem; overflow: hidden; color: var(--muted); font-size: .8rem; line-height: 1.45; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .mega__flag { display: inline-block; margin-top: .4rem; padding: .15rem .5rem; border-radius: 999px; background: var(--mint-soft); color: var(--mint-strong); font-size: .7rem; font-weight: 750; }
    .mega__link:hover { background: #f2f6f9; }
    .mega__link:hover strong span { opacity: 1; transform: none; }

    .mega__projects { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.1rem; }
    .mega__project { display: grid; gap: .25rem; }
    .mega__thumb { display: block; aspect-ratio: 16 / 11; margin-bottom: .55rem; overflow: hidden; border-radius: 6px; background: #e4ebf1; }
    .mega__thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease-out); }
    .mega__project strong { color: var(--navy); font-size: .93rem; font-weight: 750; }
    .mega__project > span:last-child { color: var(--muted); font-size: .8rem; }
    .mega__project:hover img { transform: scale(1.06); }
    .mega__project:hover strong { color: var(--brand-strong); }

    /* Compact dropdown */
    .submenu--drop .submenu__inner { padding: .5rem; border: 1px solid var(--border); border-radius: 10px; background: #fff; box-shadow: 0 30px 50px -20px rgba(10, 34, 56, .3); }
    .drop__link { display: grid; gap: .1rem; padding: .65rem .8rem; border-radius: 6px; transition: background-color .2s ease; }
    .drop__link strong { color: var(--navy); font-size: .92rem; font-weight: 750; }
    .drop__link span { color: var(--muted); font-size: .8rem; line-height: 1.4; }
    .drop__link:hover { background: #f2f6f9; }
    .drop__link:hover strong { color: var(--brand-strong); }

    /* Staggered entrance of menu contents */
    .mega__promo, .mega__col li, .mega__projects li, .drop li { opacity: 0; transform: translateY(8px); transition: opacity .3s ease, transform .45s var(--ease-out); }
    .has-menu.is-open:not(.is-suppressed) :is(.mega__promo, .mega__col li, .mega__projects li, .drop li),
    .has-menu:has(:focus-visible):not(.is-suppressed) :is(.mega__promo, .mega__col li, .mega__projects li, .drop li) { opacity: 1; transform: none; }
    .has-menu.is-open .mega__promo { transition-delay: .08s; }
    .has-menu.is-open .mega__col li { transition-delay: calc(.12s + var(--i, 0) * .06s + var(--j, 0) * .035s); }
    .has-menu.is-open .mega__projects li { transition-delay: calc(.12s + var(--i, 0) * .06s); }
    .has-menu.is-open .drop li { transition-delay: calc(.05s + var(--j, 0) * .04s); }

  }

  /* ---------- Mobile menu ---------- */
  @media (max-width: 940px) {
    .menu-toggle {
      display: inline-flex;
      background: var(--surface);
      border: 1px solid var(--border-strong);
      color: var(--text-strong);
      border-radius: 999px;
      font-weight: 600;
      padding: .45rem .9rem;
    }
    .nav {
      position: absolute;
      left: 0;
      right: 0;
      top: 84px;
      display: none;
      flex-direction: column;
      align-items: stretch;
      max-height: calc(100vh - 84px);
      overflow-y: auto;
      background: #f8fbff;
      padding: .6rem 1.2rem 1.4rem;
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
    }
    .nav.open { display: flex; animation: nav-in .35s var(--ease-out); }
    @keyframes nav-in { from { opacity: 0; transform: translateY(-8px); } }
    .nav-list { flex-direction: column; gap: 0; width: 100%; }
    .nav-item { border-bottom: 1px solid var(--border); }
    .nav-row { justify-content: space-between; }
    .nav-link, .has-menu .nav-link { flex: 1; display: block; padding: .8rem .2rem; border-radius: 0; background: none !important; font-size: 1rem; }
    .nav-caret { width: 44px; height: 44px; margin: 0; padding: 0; border-radius: 999px; }
    .nav-caret svg { width: 14px; height: 14px; }

    /* Accordion */
    .submenu { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .4s var(--ease-out); }
    .submenu__inner { min-height: 0; overflow: hidden; }
    .has-menu.is-open > .submenu { grid-template-rows: 1fr; }
    .mega { display: grid; gap: .8rem; width: auto; padding: 0 0 1rem; }
    .mega__promo, .mega__desc, .mega__thumb, .mega__project > span:last-child, .drop__link span { display: none; }
    .mega__heading { margin: .4rem 0 .2rem; color: var(--mint-strong); font-size: .7rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
    .mega__col ul, .mega__projects, .drop { display: grid; margin: 0; padding: 0; list-style: none; }
    .mega__link, .mega__project, .drop__link { display: block; padding: .5rem .2rem .5rem .8rem; border-left: 2px solid var(--border); }
    .mega__link strong, .mega__project strong, .drop__link strong { color: var(--navy); font-size: .93rem; font-weight: 650; }
    .mega__link strong span { display: none; }
    .mega__flag { display: block; margin-top: .1rem; color: var(--mint-strong); font-size: .75rem; font-weight: 700; }
    .drop { padding-bottom: .8rem; }
    .nav-phone { border: 0; padding: .9rem .2rem .5rem; }
    .nav .btn { margin-top: .4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .submenu, .submenu__inner, .nav-caret svg, .mega__promo, .mega__col li, .mega__projects li, .drop li { transition: none !important; }
    .nav.open { animation: none; }
  }
</style>
