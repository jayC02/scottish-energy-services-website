---
import { siteConfig } from "../data/site";
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Scotland based. UK wide.</p>
      <h1>
        Commercial energy & building compliance specialists
        <span class="green-dot">.</span>
      </h1>
      <p class="lead">
        Commercial EPCs, SBEM, SAP, Section 63, fire risk assessments and
        advanced building modelling across Scotland and the UK.
      </p>
      <p class="hero-audience">
        Supporting property owners, architects, developers, managing agents and
        public-sector estates.
      </p>
      <div class="actions">
        <a
          class="btn btn-primary"
          href="/quote"
          data-track="primary_cta_clicked"
        >
          Request a quote <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="#services">
          Explore our services <span aria-hidden="true">↓</span>
        </a>
      </div>
      <a
        class="hero-phone"
        href={`tel:${siteConfig.phone.replaceAll(" ", "")}`}
      >
        Discuss your project · {siteConfig.phone}
      </a>
    </div>
    <figure class="hero-image">
      <img
        src="/images/architecture-960.webp"
        srcset="/images/architecture-640.webp 640w, /images/architecture-960.webp 960w, /images/architecture-1440.webp 1440w"
        sizes="(max-width: 760px) 100vw, 48vw"
        alt="The River Clyde and Glasgow's commercial waterfront"
        width="960"
        height="540"
        fetchpriority="high"
      />
      <figcaption>
        <span>Rooted in Scotland.</span>
        <span>Supporting buildings across the UK.</span>
      </figcaption>
      <div class="image-mark" aria-hidden="true">
        SES / GLASGOW
      </div>
    </figure>
  </div>
</section>
<style>
  .hero {
    background: var(--bg);
    padding: 4.5rem 0 4rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.08fr 1fr;
    gap: 4rem;
    align-items: stretch;
  }
  .hero-copy {
    padding: 0.5rem 0;
  }
  .hero h1 {
    font-size: clamp(2.9rem, 4.6vw, 4.4rem);
    line-height: 1.04;
    max-width: 16ch;
    letter-spacing: -0.055em;
  }
  .green-dot {
    color: var(--accent);
  }
  .hero .lead {
    font-size: 1.04rem;
    max-width: 48ch;
  }
  .hero-audience {
    font-size: 0.85rem;
    color: var(--muted);
    max-width: 47ch;
  }
  .hero-phone {
    font-size: 0.75rem;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .hero-image {
    position: relative;
    min-width: 0;
    margin: 0;
    min-height: 560px;
    background: #253c37;
  }
  .hero-image img {
    width: 100%;
    height: 100%;
    position: absolute;
    object-fit: cover;
    object-position: 51% center;
  }
  .hero-image figcaption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--text-strong);
    color: white;
    padding: 1.3rem 1.5rem;
    display: grid;
    font-size: 0.8rem;
  }
  .hero-image figcaption span:last-child {
    color: #c8d0c5;
  }
  .image-mark {
    position: absolute;
    top: 1.2rem;
    left: 1.5rem;
    color: white;
    font:
      0.6rem ui-monospace,
      monospace;
    letter-spacing: 0.13em;
    border-top: 1px solid #ffffff88;
    padding-top: 0.6rem;
  }
  @media (max-width: 1000px) {
    .hero-grid {
      gap: 2rem;
    }
    .hero h1 {
      font-size: 3.2rem;
    }
  }
  @media (max-width: 760px) {
    .hero {
      padding: 2.5rem 0;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .hero h1 {
      font-size: clamp(2.6rem, 10vw, 3.6rem);
    }
    .hero-image {
      min-height: 320px;
    }
    .hero-copy {
      padding: 0;
    }
  }
</style>
