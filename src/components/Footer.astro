---
import { siteConfig } from "../data/site";
import { services } from "../data/services";
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div>
        <img
          src="/images/ses-logo-horizontal.png"
          alt="Scottish Energy Services"
          width="270"
          height="76"
          loading="lazy"
        />
        <p>
          Energy. Compliance.
          <br />
          Building performance.
        </p>
      </div>
      <div>
        <h2>Contact</h2>
        <a href={`tel:${siteConfig.phone.replaceAll(" ", "")}`}>
          {siteConfig.phone}
        </a>
        <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        <address>{siteConfig.address}</address>
      </div>
    </div>
    <div class="footer-links">
      <div>
        <h2>Services</h2>
        {services.slice(0, 5).map((s) => (
          <a href={`/services/${s.slug}`}>{s.title}</a>
        ))}
      </div>
      <div>
        <h2>Specialist assessments</h2>
        {services.slice(5).map((s) => (
          <a href={`/services/${s.slug}`}>{s.title}</a>
        ))}
      </div>
      <div>
        <h2>Sectors</h2>
        <a href="/sectors#commercial-property">Commercial property</a>
        <a href="/sectors#architects-developers">Architects & developers</a>
        <a href="/sectors#public-sector">Public sector</a>
        <a href="/sectors#education">Education</a>
        <a href="/sectors">All sectors</a>
      </div>
      <div>
        <h2>Company & resources</h2>
        <a href="/about">About SES</a>
        <a href="/projects">Projects</a>
        <a href="/insights">Insights</a>
        <a href="/areas">UK coverage</a>
        <a href="/faq">FAQs</a>
        <a href="/quote">Request a quote</a>
      </div>
    </div>
    <div class="legal">
      <span>© {new Date().getFullYear()} Scottish Energy Services</span>
      <div>
        <a href="/privacy">Privacy</a>
        <a href="/cookies">Cookies</a>
        <button type="button" data-cookie-settings>
          Cookie preferences
        </button>
      </div>
    </div>
  </div>
</footer>
<div class="mobile-actions">
  <a class="btn btn-ghost" href={`tel:${siteConfig.phone.replaceAll(" ", "")}`}>
    Call our team
  </a>
  <a class="btn btn-primary" href="/quote" data-track="primary_cta_clicked">
    Request a quote ↗
  </a>
</div>
<style>
  .footer {
    background: var(--bg);
    padding: 4rem 0 1.5rem;
    border-top: 1px solid var(--border);
  }
  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 3rem;
  }
  .footer-top img {
    width: 230px;
    height: auto;
    margin-bottom: 1.5rem;
  }
  .footer-top p {
    font-size: 1.7rem;
    line-height: 1.3;
    letter-spacing: -0.04em;
  }
  .footer h2 {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    margin-bottom: 1.2rem;
  }
  .footer a {
    display: block;
    font-size: 0.85rem;
    margin-bottom: 0.6rem;
    overflow-wrap: anywhere;
  }
  .footer a:hover {
    text-decoration: underline;
  }
  .footer address {
    font-style: normal;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .footer-links {
    display: grid;
    grid-template-columns: 1.2fr 1.5fr 1fr 1fr;
    gap: 2rem;
    padding: 2.5rem 0;
    border-top: 1px solid var(--border);
  }
  .legal {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--muted);
    gap: 1rem;
  }
  .legal div {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .legal a,
  .legal button {
    font-size: 0.7rem;
  }
  .legal button {
    border: 0;
    background: none;
    padding: 0;
    color: inherit;
    align-self: start;
  }
  @media (max-width: 760px) {
    .footer-top {
      display: block;
    }
    .footer-links {
      grid-template-columns: 1fr 1fr;
    }
    .legal {
      display: block;
    }
    .legal div {
      margin-top: 1rem;
    }
  }
</style>
