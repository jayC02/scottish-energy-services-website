---
import { services, serviceCategories, turnaroundOf } from '../data/services';
import { serviceVisuals } from '../data/service-visuals';
import { getServicePrice, startingPrice } from '../data/pricing';
import { turnaroundPromise } from '../data/site';
import { coverageRegions } from '../data/coverage';
interface Props { page?: boolean; }
const { page = false } = Astro.props;
const Heading = page ? 'h1' : 'h2';
const CardHeading = page ? 'h2' : 'h3';
const reveal = (variant = '') => page ? {} : { 'data-animate': variant };
const enter = page ? 'enter' : undefined;
const countFor = (id: string) => services.filter(service => service.category === id).length;
---
<section class:list={['svc', { 'svc--page': page }]} aria-labelledby="services-heading">
  <div class="container">
    <header class="svc-head">
      <div class="svc-head__title">
        <p class:list={['svc-eyebrow', enter]} {...reveal('fade')}>Our services</p>
        <Heading id="services-heading" class={enter} style="--d:80ms" {...reveal()}>Energy, compliance and fire safety assessments.</Heading>
      </div>
      <div class:list={['svc-head__aside', enter]} style="--d:160ms" {...reveal()}>
        <p>Assessments for homes, commercial buildings and public estates across Scotland and the north of England, each backed by our {turnaroundPromise.hours}-hour turnaround.</p>
        {!page && <a class="svc-head__link" href="/services">View all services <span aria-hidden="true">→</span></a>}
      </div>
    </header>

    <div class:list={['svc-promise', { 'enter svc-promise--load': page }]} style="--d:240ms" {...reveal('scale')}>
      <div class="svc-promise__figure">
        <svg class="svc-promise__ring" viewBox="0 0 120 120" aria-hidden="true">
          <circle cx="60" cy="60" r="54" class="svc-promise__track" />
          <circle cx="60" cy="60" r="54" class="svc-promise__arc" />
        </svg>
        <span class="svc-promise__num"><span data-countup={turnaroundPromise.hours}>{turnaroundPromise.hours}</span><small>hrs</small></span>
      </div>
      <div class="svc-promise__copy">
        <strong>From site visit to finished report in {turnaroundPromise.hours} hours.</strong>
        <p>It’s our standard on every service, and Domestic EPCs and Legionella assessments are completed the same day. We agree the scope and fixed fee before we start.</p>
      </div>
      <ul class="svc-promise__points">
        <li><span>{services.length}</span> specialist services</li>
        <li><span>£</span> Fixed fee agreed upfront</li>
        <li><span>{coverageRegions.length}</span> regions across Scotland and the north of England</li>
      </ul>
    </div>

    {page && <div class="svc-filter" data-service-filter hidden>
      <div class="svc-filter__buttons" role="group" aria-label="Filter services">
        <button type="button" data-filter="all" aria-pressed="true">All services <span>{services.length}</span></button>
        {serviceCategories.map(category => <button type="button" data-filter={category.id} aria-pressed="false">{category.label} <span>{countFor(category.id)}</span></button>)}
      </div>
      <p class="sr-only" data-filter-status aria-live="polite"></p>
    </div>}

    <div class="svc-grid">
      {services.map((service, index) => {
        const image = serviceVisuals[service.slug];
        const price = getServicePrice(service.slug);
        return <article class="svc-card" data-category={service.category} data-animate style={`--d:${(index % 3) * 90}ms`}>
          <a class="svc-card__link" href={`/services/${service.slug}`} aria-labelledby={`service-${service.slug}`}>
            <div class="svc-card__media">
              <img src={image.src} srcset={image.small ? `${image.small} ${image.smallWidth || 640}w, ${image.src} ${image.width || 1280}w` : undefined} sizes="(min-width: 1051px) 380px, (min-width: 661px) 46vw, 92vw" width={image.width || 1280} height={image.height || 720} alt="" loading={page && index < 3 ? 'eager' : 'lazy'} fetchpriority={page && index === 0 ? 'high' : undefined} decoding="async" style={`object-position: ${image.position || '50% 45%'}`} />
            </div>
            <div class="svc-card__body">
              <span class="svc-card__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <CardHeading id={`service-${service.slug}`}>{service.title}</CardHeading>
              <p class="svc-card__desc">{service.short}</p>
              <div class="svc-card__meta">
                <span class="svc-card__speed">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8" /><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  {turnaroundOf(service).label}
                </span>
                <span class:list={['svc-card__price', { 'svc-card__price--bespoke': !price }]}>{price ? startingPrice(price) : 'Tailored quote'}</span>
              </div>
              <span class="svc-card__cta">Explore service <span class="svc-card__arrow" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span></span>
            </div>
          </a>
        </article>;
      })}
    </div>
    <p class="svc-note">Prices exclude VAT. We confirm the scope and full fee before work begins. <a href="/#pricing">View pricing</a>.</p>
  </div>
</section>

<style>
  .svc { padding: clamp(3.5rem, 7vw, 6.5rem) 0 clamp(3rem, 5vw, 4.5rem); background: #fff; }
  .svc--page { padding-top: clamp(3rem, 6vw, 5rem); background: linear-gradient(180deg, #f3f7fa 0, #fff 420px); }

  /* Heading */
  .svc-head { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); gap: clamp(1.5rem, 5vw, 5rem); align-items: end; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .svc-eyebrow { display: inline-flex; align-items: center; gap: .7rem; margin: 0 0 1.1rem; color: var(--mint-strong); font-size: .78rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .svc-eyebrow::before { content: ''; width: 28px; height: 2px; background: currentColor; }
  .svc-head :is(h1, h2) { margin: 0; max-width: 16ch; color: var(--navy); font-size: clamp(2.2rem, 4.6vw, 3.75rem); font-weight: 800; line-height: 1.04; letter-spacing: -.04em; text-wrap: balance; }
  .svc-head__aside p { margin: 0; color: var(--muted); font-size: 1.02rem; line-height: 1.65; }
  .svc-head__link { display: inline-flex; align-items: center; gap: .5rem; margin-top: 1.1rem; color: var(--brand-strong); font-weight: 750; border-bottom: 2px solid var(--brand); padding-bottom: .2rem; transition: gap .25s var(--ease-out); }
  .svc-head__link:hover { gap: .85rem; }

  /* 48-hour promise */
  .svc-promise { position: relative; overflow: hidden; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: clamp(1.4rem, 3.5vw, 3rem); margin-bottom: clamp(2rem, 4vw, 3rem); padding: clamp(1.4rem, 3vw, 2rem) clamp(1.4rem, 3.5vw, 2.6rem); border-radius: 6px; background: linear-gradient(120deg, var(--navy) 0%, var(--navy-2) 100%); color: #fff; box-shadow: 0 30px 60px -30px rgba(10, 34, 56, .55); }
  .svc-promise::after { content: ''; position: absolute; right: -60px; top: -60px; width: 240px; height: 240px; background: var(--mint); opacity: .09; transform: rotate(18deg); pointer-events: none; }
  .svc-promise__figure { position: relative; display: grid; place-items: center; width: 118px; height: 118px; flex: none; }
  .svc-promise__ring { position: absolute; inset: 0; transform: rotate(-90deg); }
  .svc-promise__track, .svc-promise__arc { fill: none; stroke-width: 4; }
  .svc-promise__track { stroke: rgba(255, 255, 255, .12); }
  .svc-promise__arc { stroke: var(--mint); stroke-linecap: round; stroke-dasharray: 340; stroke-dashoffset: 0; transition: stroke-dashoffset 1.6s var(--ease-out) .2s; }
  :global(.motion-ready) .svc-promise[data-animate]:not(.is-in) .svc-promise__arc { stroke-dashoffset: 340; }
  .svc-promise--load .svc-promise__arc { animation: arc-draw 1.8s var(--ease-out) .5s both; }
  @keyframes arc-draw { from { stroke-dashoffset: 340; } }
  .svc-promise__num { display: flex; align-items: baseline; gap: .15rem; color: var(--mint); font-size: 2.9rem; font-weight: 800; letter-spacing: -.05em; line-height: 1; font-variant-numeric: tabular-nums; }
  .svc-promise__num small { font-size: .85rem; font-weight: 750; letter-spacing: .02em; color: #fff; }
  .svc-promise__copy strong { display: block; font-size: clamp(1.15rem, 2vw, 1.45rem); line-height: 1.25; letter-spacing: -.02em; }
  .svc-promise__copy p { margin: .5rem 0 0; color: #b9cad8; font-size: .95rem; line-height: 1.6; max-width: 56ch; }
  .svc-promise__points { position: relative; z-index: 1; display: grid; gap: .65rem; margin: 0; padding: 0 0 0 clamp(1.2rem, 3vw, 2.4rem); list-style: none; border-left: 1px solid rgba(255, 255, 255, .14); font-size: .9rem; font-weight: 650; white-space: nowrap; }
  .svc-promise__points span { display: inline-grid; place-items: center; min-width: 2.1rem; height: 1.6rem; margin-right: .55rem; padding: 0 .35rem; border-radius: 4px; background: rgba(76, 175, 148, .14); color: var(--mint); font-size: .74rem; font-weight: 800; }

  /* Filter */
  .svc-filter { margin-bottom: 1.6rem; }
  .svc-filter[hidden] { display: none; }
  .svc-filter__buttons { display: flex; flex-wrap: wrap; gap: .55rem; }
  .svc-filter button { display: inline-flex; align-items: center; gap: .55rem; padding: .62rem 1rem; border: 1px solid var(--border-strong); border-radius: 999px; background: #fff; color: var(--navy); font: inherit; font-size: .88rem; font-weight: 700; cursor: pointer; transition: background-color .25s ease, color .25s ease, border-color .25s ease; }
  .svc-filter button span { display: inline-grid; place-items: center; min-width: 1.45rem; height: 1.45rem; border-radius: 999px; background: #eaf0f5; color: var(--muted); font-size: .72rem; }
  .svc-filter button:hover { border-color: var(--navy); }
  .svc-filter button[aria-pressed='true'] { background: var(--navy); border-color: var(--navy); color: #fff; }
  .svc-filter button[aria-pressed='true'] span { background: rgba(255, 255, 255, .18); color: #fff; }

  /* Cards */
  .svc-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 24px; }
  .svc-card { min-width: 0; }
  .svc-card[hidden] { display: none; }
  .svc-card.card-pop { animation: rise-in .7s var(--ease-out) both; animation-delay: var(--d, 0ms); }
  .svc-card__link { position: relative; display: flex; flex-direction: column; height: 100%; overflow: hidden; border: 1px solid #e3eaf0; border-radius: 6px; background: #fff; color: var(--text-strong); box-shadow: 0 1px 2px rgba(10, 34, 56, .04); transition: transform .5s var(--ease-out), box-shadow .5s var(--ease-out), border-color .3s ease; }
  .svc-card__link::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: linear-gradient(90deg, var(--brand), var(--mint)); transform: scaleX(0); transform-origin: left; transition: transform .6s var(--ease-out); }
  .svc-card__media { position: relative; aspect-ratio: 16 / 10.5; overflow: hidden; background: #dfe7ee; }
  .svc-card__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10, 34, 56, 0) 60%, rgba(10, 34, 56, .28) 100%); transition: opacity .5s ease; }
  .svc-card__media img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.01); transition: transform 1.1s var(--ease-out); }
  .svc-card__body { position: relative; display: flex; flex: 1; flex-direction: column; padding: 22px 24px 22px; }
  .svc-card__index { position: absolute; top: 20px; right: 22px; color: #c7d3dd; font-size: .8rem; font-weight: 800; font-variant-numeric: tabular-nums; transition: color .3s ease; }
  .svc-card__body :is(h2, h3) { margin: 0; padding-right: 2rem; color: var(--navy); font-size: 1.28rem; font-weight: 800; line-height: 1.22; letter-spacing: -.03em; }
  .svc-card__desc { margin: .6rem 0 1.2rem; color: var(--muted); font-size: .92rem; line-height: 1.58; }
  .svc-card__meta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .5rem 1rem; margin-top: auto; padding: .9rem 0; border-top: 1px solid #e8eef3; border-bottom: 1px solid #e8eef3; }
  .svc-card__speed { display: inline-flex; align-items: center; gap: .4rem; color: var(--mint-strong); font-size: .8rem; font-weight: 750; }
  .svc-card__price { color: var(--navy); font-size: .82rem; font-weight: 750; }
  .svc-card__price--bespoke { color: var(--muted); font-weight: 600; }
  .svc-card__cta { display: flex; justify-content: space-between; align-items: center; padding-top: 1rem; color: var(--navy); font-size: .9rem; font-weight: 750; }
  .svc-card__arrow { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid #d5e0e9; border-radius: 999px; transition: background-color .35s ease, border-color .35s ease, color .35s ease, transform .45s var(--ease-out); }
  .svc-card__link:focus-visible { outline: 3px solid var(--brand); outline-offset: 4px; }

  .svc-note { margin: 1.6rem 0 0; color: var(--muted); font-size: .8rem; line-height: 1.6; }
  .svc-note a { color: var(--brand-strong); text-decoration: underline; text-underline-offset: 3px; }

  @media (hover: hover) {
    .svc-card__link:hover { transform: translateY(-6px); border-color: transparent; box-shadow: 0 28px 50px -24px rgba(10, 34, 56, .35); }
    .svc-card__link:hover::after { transform: scaleX(1); }
    .svc-card__link:hover .svc-card__media img { transform: scale(1.07); }
    .svc-card__link:hover .svc-card__index { color: var(--brand); }
    .svc-card__link:hover .svc-card__arrow { background: var(--brand); border-color: var(--brand); color: #fff; transform: translateX(3px); }
  }

  @media (max-width: 1050px) {
    .svc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .svc-promise { grid-template-columns: auto minmax(0, 1fr); }
    .svc-promise__points { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: .7rem 1.4rem; padding: 1.1rem 0 0; border-left: 0; border-top: 1px solid rgba(255, 255, 255, .14); }
  }
  @media (max-width: 760px) {
    .svc-head { grid-template-columns: 1fr; }
  }
  @media (max-width: 660px) {
    .svc-grid { grid-template-columns: 1fr; gap: 20px; }
    .svc-promise { grid-template-columns: 1fr; text-align: left; }
    .svc-promise__figure { width: 96px; height: 96px; }
    .svc-promise__num { font-size: 2.3rem; }
    .svc-promise__points { white-space: normal; }
    .svc-card__body { padding: 20px; }
    .svc-filter__buttons { flex-wrap: nowrap; overflow-x: auto; margin: 0 -4vw; padding: 2px 4vw 6px; scrollbar-width: none; }
    .svc-filter button { flex: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .svc-card__link, .svc-card__link::after, .svc-card__media img, .svc-card__arrow, .svc-promise__arc { transition: none; animation: none; }
    .svc-card__link:hover { transform: none; }
    .svc-card__link:hover .svc-card__media img { transform: scale(1.01); }
  }
</style>
