---
import { services } from "../data/services";
const primary = [
  "commercial-epcs",
  "sbem-calculations",
  "saps",
  "section-63-assessments",
  "fras",
  "dynamic-simulation-modelling-dsm",
].map((slug) => services.find((s) => s.slug === slug)!);
const extra = services.filter(
  (s) => !primary.includes(s) && s.slug !== "domestic-epcs-and-legionellas",
);
---

<section class="section" id="services">
  <div class="container">
    <p class="eyebrow">Our expertise</p>
    <div class="section-heading wide">
      <h2>Clarity for every stage of your building.</h2>
      <p class="lead">
        From a property transaction to a new development. The right assessment,
        a clear scope and reporting your team can use.
      </p>
    </div>
    <div class="service-grid">
      {primary.map((s, i) => (
        <a
          href={`/services/${s.slug}`}
          class="service-item"
          data-track="service_cta_clicked"
          data-service={s.slug}
        >
          <span class="number">0{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.short}</p>
          <span class="service-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
    </div>
    <div class="supplementary">
      <p class="eyebrow">Further specialist services</p>
      {extra.map((s) => (
        <a
          class="text-link"
          href={`/services/${s.slug}`}
          data-track="service_cta_clicked"
          data-service={s.slug}
        >
          {s.title} ↗
        </a>
      ))}
    </div>
  </div>
</section>
<style>
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--border);
  }
  .service-item {
    padding: 2rem 2.5rem 2rem 0;
    border-bottom: 1px solid var(--border);
    position: relative;
    display: block;
  }
  .service-item:not(:nth-child(3n + 1)) {
    padding-left: 2rem;
    border-left: 1px solid var(--border);
  }
  .service-item h3 {
    font-size: 1.5rem;
    margin: 1.5rem 0 0.8rem;
    max-width: 23ch;
  }
  .service-item p {
    font-size: 0.88rem;
    color: var(--muted);
    max-width: 31ch;
    margin-bottom: 1.3rem;
  }
  .service-item:hover h3 {
    color: var(--brand);
  }
  .service-arrow {
    font-size: 1.5rem;
    color: var(--brand);
  }
  .supplementary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.4rem;
    margin-top: 2rem;
  }
  .supplementary .eyebrow {
    width: 100%;
    margin: 0;
  }
  .supplementary a {
    font-size: 0.8rem;
  }
  @media (max-width: 760px) {
    .service-grid {
      grid-template-columns: 1fr 1fr;
    }
    .service-item,
    .service-item:not(:nth-child(3n + 1)) {
      padding: 1.5rem 1rem 1.5rem 0;
      border-left: 0;
    }
    .service-item:nth-child(even) {
      padding-left: 1rem;
      border-left: 1px solid var(--border);
    }
    .service-item h3 {
      font-size: 1.2rem;
    }
    .service-item p {
      font-size: 0.8rem;
    }
  }
  @media (max-width: 380px) {
    .service-grid {
      grid-template-columns: 1fr;
    }
    .service-item:nth-child(even) {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
