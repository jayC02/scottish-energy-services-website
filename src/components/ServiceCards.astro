---
import { services } from '../data/services';
const preview = Astro.props.preview ?? false;
const list = preview ? services : services;
---
<section class="section service-band">
  <div class="container">
    <div class="service-heading">
      <div>
        <p class="eyebrow">Services We Offer</p>
        <h2 class="section-title">Specialist energy and compliance services</h2>
      </div>
    </div>

    <div class="service-grid">
      {list.map((service, index) => (
        <article
          class={`service-card ${index < 3 ? 'service-card--featured' : ''}`}
          data-reveal
          style={`--index:${index};`}
        >
          <p class="service-index">{String(index + 1).padStart(2, '0')}</p>
          <h3>{service.title}</h3>
          <p class="service-description">{service.short}</p>
          <ul class="service-highlights">
            {service.highlights.slice(0, 2).map((item) => <li>{item}</li>)}
          </ul>
          <a href={`/services/${service.slug}`} class="service-link">
            View service <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .service-band {
    position: relative;
    padding-top: 1.5rem;
  }

  .service-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(280px, .72fr);
    gap: clamp(2rem, 5vw, 5.5rem);
    align-items: end;
    margin-bottom: 1.6rem;
  }

  .service-heading .section-title {
    max-width: 18ch;
    margin-bottom: 0;
  }

  .service-lead {
    margin: 0 0 .15rem;
    max-width: 48ch;
  }

  .service-grid {
    margin-top: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
  }

  .service-card {
    grid-column: span 4;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 270px;
    padding: 1.6rem;
    background: #ffffff;
    border: 1px solid #d9e3ec;
    border-radius: 14px;
    box-shadow:
      0 2px 5px rgba(15, 27, 42, 0.025),
      0 10px 30px rgba(15, 27, 42, 0.045);
    transition:
      transform .25s ease,
      border-color .25s ease,
      box-shadow .25s ease;
  }

  .service-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 4px;
    height: 100%;
    background: var(--brand);
    transform: scaleY(.25);
    transform-origin: top;
    transition: transform .3s cubic-bezier(.2, .8, .2, 1);
  }

  .service-card:hover {
    transform: translateY(-4px);
    border-color: #b9cedd;
    box-shadow:
      0 4px 10px rgba(15, 27, 42, 0.04),
      0 18px 42px rgba(15, 27, 42, 0.09);
  }

  .service-card:hover::before {
    transform: scaleY(1);
  }

  .service-index {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    margin: 0 0 1.2rem;
    border-radius: 8px;
    background: var(--brand-soft);
    color: var(--brand-strong);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .04em;
  }

  h3 {
    margin: 0 0 .68rem;
    color: var(--text-strong);
    font-size: 1.2rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .service-description {
    margin: 0;
    color: var(--muted);
    line-height: 1.55;
  }

  .service-highlights {
    display: grid;
    gap: .42rem;
    margin: 1rem 0 1.35rem;
    padding: 0;
    list-style: none;
  }

  .service-highlights li {
    position: relative;
    padding-left: 1rem;
    color: #52657a;
    font-size: .9rem;
  }

  .service-highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: .5rem;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--brand);
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    width: fit-content;
    margin-top: auto;
    color: var(--brand-strong);
    font-weight: 650;
  }

  .service-link span {
    transition: transform .2s ease;
  }

  .service-card:hover .service-link span {
    transform: translateX(4px);
  }

  .service-card--featured {
    background: linear-gradient(145deg, #102236 0%, #13334c 100%);
    border-color: transparent;
    box-shadow:
      0 8px 20px rgba(15, 27, 42, .08),
      0 20px 40px rgba(15, 27, 42, .09);
  }

  .service-card--featured::before {
    background: #52a9d4;
  }

  .service-card--featured .service-index {
    background: rgba(255, 255, 255, .09);
    color: #a8d8f0;
  }

  .service-card--featured h3 {
    color: #ffffff;
  }

  .service-card--featured .service-description {
    color: #c7d5e2;
  }

  .service-card--featured .service-highlights li {
    color: #bccddd;
  }

  .service-card--featured .service-highlights li::before {
    background: #66b9df;
  }

  .service-card--featured .service-link {
    color: #ffffff;
  }

  .service-card--featured:hover {
    border-color: rgba(115, 190, 224, .5);
    box-shadow:
      0 8px 20px rgba(15, 27, 42, .11),
      0 24px 48px rgba(15, 27, 42, .16);
  }

  @media (max-width: 1080px) {
    .service-heading {
      grid-template-columns: 1fr;
      gap: .8rem;
    }

    .service-heading .section-title {
      max-width: 22ch;
    }

    .service-lead {
      max-width: 62ch;
    }

    .service-card {
      grid-column: span 6;
      min-height: 255px;
    }
  }

  @media (max-width: 700px) {
    .service-band {
      padding-top: 1rem;
    }

    .service-heading {
      margin-bottom: 1.25rem;
    }

    .service-grid {
      gap: .8rem;
    }

    .service-card {
      grid-column: 1 / -1;
      min-height: unset;
      padding: 1.35rem;
    }
  }
</style>
