---
import FAQGroup from './FAQGroup.astro';
import { faqColumns } from '../data/faq-page';
const limit = Astro.props.limit ?? 6;
const general = faqColumns[0][0];
const pricing = faqColumns[0][1];
const generalItems = [general.items[0], general.items[2], general.items[3]].slice(0, limit);
const pricingItems = pricing.items.slice(0, Math.max(0, limit - generalItems.length));
---
<section class="section surface-band">
  <div class="container">
    <div class="section-heading">
      <h2 class="section-title">Frequently asked questions</h2>
    </div>
    <div class="faq-preview">
      <FAQGroup group={{ ...general, items: generalItems }} headingLevel={3} />
      {pricingItems.length > 0 && <FAQGroup group={{ ...pricing, items: pricingItems }} headingLevel={3} />}
    </div>
    <a class="faq-all" href="/faq">View all frequently asked questions <span aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .faq-preview { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: clamp(2rem, 5vw, 4rem); }
  .section-heading { margin-bottom: 1.3rem; }
  .faq-all { display: inline-block; margin-top: 1.3rem; color: var(--brand-strong); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 760px) { .faq-preview { grid-template-columns: 1fr; gap: 1.6rem; } }
</style>
