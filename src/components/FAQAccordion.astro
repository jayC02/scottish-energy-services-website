---
import { faqs } from "../data/faqs";
const { limit } = Astro.props;
const items = limit ? faqs.slice(0, limit) : faqs;
---

<section class="section">
  <div class="container">
    <p class="eyebrow">Your questions</p>
    <h2>Before you instruct.</h2>
    <div class="faq-list">
      {items.map((f) => (
        <details>
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
