---
const {
  title = 'Ready to move your project forward?',
  text = 'Tell us what you are working on and we will confirm the right service, scope and next available delivery window.',
  button = 'Request a quote'
} = Astro.props;
---

<section class="section cta-section">
  <div class="container" data-reveal>
    <div class="cta-panel">
      <div>
        <p class="eyebrow cta-eyebrow">Start a conversation</p>
        <h2>{title}</h2>
      </div>

      <div class="cta-action">
        <p>{text}</p>
        <a class="cta-button" href="/quote">
          {button}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-top: clamp(2.5rem, 4vw, 4rem);
  }

  .cta-panel {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, .72fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
    padding: clamp(2rem, 4vw, 3.5rem);
    border-radius: 20px;
    background:
      radial-gradient(circle at 88% 12%, rgba(91, 195, 230, .2), transparent 28%),
      linear-gradient(135deg, #0e2234 0%, #123550 100%);
    box-shadow: 0 24px 60px rgba(15, 35, 53, .14);
  }

  .cta-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to left, black, transparent 70%);
  }

  .cta-panel > * {
    position: relative;
    z-index: 1;
  }

  .cta-eyebrow {
    color: #74c8ef;
  }

  .cta-panel h2 {
    margin: 0;
    max-width: 11ch;
    color: #fff;
    font-size: clamp(2.15rem, 4vw, 3.8rem);
    line-height: 1.04;
    letter-spacing: -.035em;
  }

  .cta-action p {
    margin: 0 0 1.25rem;
    max-width: 48ch;
    color: #bfd0dd;
    line-height: 1.55;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-width: 210px;
    padding: .9rem 1rem;
    border-radius: 10px;
    background: #fff;
    color: #10263a;
    font-weight: 700;
    transition: transform .2s ease, box-shadow .2s ease;
  }

  .cta-button span {
    color: var(--brand);
    font-size: 1.2rem;
    transition: transform .2s ease;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0,0,0,.14);
  }

  .cta-button:hover span {
    transform: translateX(4px);
  }

  @media (max-width: 820px) {
    .cta-panel {
      grid-template-columns: 1fr;
      gap: 1.7rem;
    }

    .cta-panel h2 {
      max-width: 15ch;
    }
  }
</style>
