---
import SpotlightSurface from './bits/SpotlightSurface.astro';

const items = [
  ['01', 'Accredited assessments', 'Delivered to recognised standards'],
  ['02', 'Domestic & commercial', 'Single properties to portfolio programmes'],
  ['03', 'Scotland-based', 'Project delivery across the UK'],
  ['04', 'Clear technical reporting', 'Practical outputs built for action']
];
---

<section class="ses-trust-section" aria-label="Scottish Energy Services credentials">
  <div class="container ses-trust-grid">
    {items.map(([number, title, text]) => (
      <SpotlightSurface class="ses-trust-card" spotlightColor="rgba(76, 184, 229, 0.16)">
        <span class="ses-trust-number">{number}</span>
        <strong>{title}</strong>
        <p>{text}</p>
      </SpotlightSurface>
    ))}
  </div>
</section>

<style is:global>
  .ses-trust-section {
    padding: 1rem 0 1.25rem;
    background: #fff;
  }

  .ses-trust-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: .75rem;
  }

  .ses-trust-card {
    min-height: 150px;
    padding: 1.25rem 1.2rem;
    border: 1px solid #d7e1eb;
    border-radius: 14px;
    background:
      linear-gradient(180deg, rgba(255,255,255,.98), rgba(247,250,253,.98));
    box-shadow: 0 8px 28px rgba(17, 39, 61, .05);
    transition:
      transform .25s ease,
      border-color .25s ease,
      box-shadow .25s ease;
  }

  .ses-trust-card:hover {
    transform: translateY(-3px);
    border-color: #b8cfdf;
    box-shadow: 0 16px 38px rgba(17, 39, 61, .09);
  }

  .ses-trust-number {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-bottom: 1rem;
    border-radius: 7px;
    background: #e8f3fa;
    color: #0c6795;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .7rem;
    font-weight: 800;
  }

  .ses-trust-card strong {
    display: block;
    margin-bottom: .35rem;
    color: var(--text-strong);
    font-size: 1rem;
    line-height: 1.3;
  }

  .ses-trust-card p {
    margin: 0;
    color: var(--muted);
    font-size: .9rem;
    line-height: 1.5;
  }

  @media (max-width: 980px) {
    .ses-trust-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .ses-trust-section {
      padding-top: .6rem;
    }

    .ses-trust-grid {
      grid-template-columns: 1fr;
      gap: .65rem;
    }

    .ses-trust-card {
      min-height: 0;
      padding: 1rem;
    }
  }
</style>
