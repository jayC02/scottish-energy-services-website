---
import { sectors } from "../data/sectors";
---

<section class="section">
  <div class="container">
    <p class="eyebrow">Who we work with</p>
    <div class="section-heading wide">
      <h2>Built around your sector.</h2>
      <p class="lead">
        Advice that takes account of how your buildings are designed, occupied
        and managed.
      </p>
    </div>
    <div class="sector-list">
      {sectors.map((s, i) => (
        <a href={`/sectors#${s.slug}`}>
          <span class="number">0{i + 1}</span>
          <h3>{s.title}</h3>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>
</section>
<style>
  .sector-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 3rem;
  }
  .sector-list a {
    display: flex;
    align-items: center;
    gap: 1.3rem;
    padding: 1.6rem 0;
    border-top: 1px solid var(--border);
  }
  .sector-list h3 {
    font-size: 1.25rem;
    flex: 1;
    margin: 0;
  }
  .sector-list a:hover h3 {
    color: var(--brand);
  }
  @media (max-width: 760px) {
    .sector-list {
      grid-template-columns: 1fr;
    }
  }
</style>
