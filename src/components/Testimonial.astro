---
import { testimonials } from "../data/projects";
---

{testimonials
  .filter((t) => t.approved)
  .map((t) => (
    <figure class="testimonial">
      <blockquote>{t.quote}</blockquote>
      <figcaption>
        {t.name} · {t.role}
      </figcaption>
    </figure>
  ))}
<style>
  .testimonial {
    margin: 2rem 0;
    padding: 2rem 0;
    border-block: 1px solid var(--border);
  }
  blockquote {
    font-size: 1.7rem;
    line-height: 1.4;
    margin: 0 0 1rem;
  }
  figcaption {
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
