---
const clients = [
  { name: "M&S", src: "/images/client-logos/marks-and-spencer.webp" },
  { name: "Savills", src: "/images/client-logos/savills.svg" },
  {
    name: "Glasgow City Council",
    src: "/images/client-logos/glasgow-city-council.webp",
  },
  { name: "Hilton", src: "/images/client-logos/hilton.webp" },
  {
    name: "The University of Edinburgh",
    src: "/images/client-logos/university-of-edinburgh.webp",
  },
  { name: "Max Fordham", src: "/images/client-logos/max-fordham.svg" },
  { name: "Aldi", src: "/images/client-logos/aldi.svg" },
  { name: "Knight Frank", src: "/images/client-logos/knight-frank.svg" },
  { name: "AGS Airports", src: "/images/client-logos/ags-airports.webp" },
  {
    name: "IHG Hotels & Resorts",
    src: "/images/client-logos/ihg-hotels-resorts.svg",
  },
  {
    name: "University of Glasgow",
    src: "/images/client-logos/university-of-glasgow.svg",
  },
  { name: "Glasgow Life", src: "/images/client-logos/glasgow-life.svg" },
  {
    name: "Praxis Real Estate Management",
    src: "/images/client-logos/praxis-real-estate-management.webp",
  },
  {
    name: "Southside Housing Association",
    src: "/images/client-logos/southside-housing-association.webp",
  },
  {
    name: "Marine & Lawn Hotels & Resorts",
    src: "/images/client-logos/marine-lawn-hotels-resorts.webp",
  },
  {
    name: "Peel Retail & Leisure",
    src: "/images/client-logos/peel-retail-leisure.svg",
  },
  {
    name: "University of the West of Scotland",
    src: "/images/client-logos/university-of-the-west-of-scotland.svg",
  },
  { name: "Keegans", src: "/images/client-logos/keegans.svg" },
  { name: "Estama", src: "/images/client-logos/estama.svg" },
  { name: "Cairn Group", src: "/images/client-logos/cairn-group.webp" },
];

const { all = false } = Astro.props;
const shown = all ? clients : clients.slice(0, 6);
---

<section class="client-section">
  <div class="container">
    <div class="client-heading">
      <h2>Trusted by organisations across the UK</h2>
      <a href="/projects" class="text-link">
        View selected projects ↗
      </a>
    </div>
    <ul class="logo-grid">
      {shown.map((c) => (
        <li>
          <img
            src={c.src}
            alt={c.name}
            width="200"
            height="80"
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .client-section {
    padding: 3rem 0;
    border-bottom: 1px solid var(--border);
  }
  .client-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .client-heading h2 {
    font-size: 0.85rem;
    letter-spacing: 0;
    margin: 0;
    color: var(--muted);
  }
  .client-heading a {
    font-size: 0.75rem;
  }
  .logo-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    align-items: center;
    gap: 2.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .logo-grid img {
    width: 100%;
    height: 55px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.72;
    transition:
      filter 0.2s,
      opacity 0.2s;
  }
  .logo-grid img:hover {
    filter: none;
    opacity: 1;
  }
  @media (max-width: 760px) {
    .logo-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.8rem;
    }
    .logo-grid img {
      height: 42px;
    }
    .client-heading {
      display: block;
    }
    .client-heading a {
      margin-top: 0.8rem;
    }
  }
</style>
