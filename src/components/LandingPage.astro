---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceDetail from "./ServiceDetail.astro";
import { services } from "../data/services";
interface Props {
  slug: string;
  title: string;
  heading: string;
  description: string;
  intro: string;
  area: string;
}
const { slug, title, heading, description, intro, area } = Astro.props;
const service = services.find((s) => s.slug === slug)!;
---

<BaseLayout title={title} description={description} minimal>
  <ServiceDetail
    service={service}
    heading={heading}
    intro={intro}
    area={area}
    landing
  />
</BaseLayout>
