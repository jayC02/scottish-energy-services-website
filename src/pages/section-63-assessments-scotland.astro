---
// Retained for existing links and campaigns; primary search URL is the service page.
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceDetail from '../components/ServiceDetail.astro';
import { getServicePage } from '../data/service-pages';
const { service, detail, schema } = getServicePage('section-63-assessments');
---
<BaseLayout title={detail.title} description={detail.description} canonical="/services/section-63-assessments" structuredData={schema}>
  <ServiceDetail service={service} />
</BaseLayout>
