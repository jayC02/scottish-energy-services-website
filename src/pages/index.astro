---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import TrustStrip from "../components/TrustStrip.astro";
import ClientLogoCarousel from "../components/ClientLogoCarousel.astro";
import ServiceCards from "../components/ServiceCards.astro";
import ProjectFeature from "../components/ProjectFeature.astro";
import Sectors from "../components/Sectors.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import CTASection from "../components/CTASection.astro";
import Testimonial from "../components/Testimonial.astro";
---

<BaseLayout
  title="Commercial Energy & Building Compliance Specialists"
  description="Commercial EPCs, SBEM, SAP, Section 63, fire risk assessments and building modelling. Glasgow-based technical support across Scotland and the UK."
>
  <Hero />
  <TrustStrip />
  <ClientLogoCarousel />
  <ServiceCards />
  <ProjectFeature />
  <Sectors />
  <section class="proof">
    <div class="container proof-grid">
      <div>
        <strong>12,573</strong>
        <span>Projects delivered</span>
      </div>
      <div>
        <strong>4</strong>
        <span>UK nations supported</span>
      </div>
      <div>
        <strong>
          One building.
          <br />
          Or a whole portfolio.
        </strong>
        <span>Support shaped around your instruction</span>
      </div>
    </div>
  </section>
  <WhyChooseUs />
  <ProcessSteps />
  <div class="container">
    <Testimonial />
  </div>
  <CTASection />
</BaseLayout>
<style>
  .proof {
    padding: 3.5rem 0;
    border-block: 1px solid var(--border);
  }
  .proof-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1.3fr;
    gap: 3rem;
  }
  .proof strong {
    display: block;
    font-size: 3.8rem;
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: var(--brand-strong);
  }
  .proof span {
    display: block;
    font-size: 0.8rem;
    margin-top: 1rem;
    color: var(--muted);
  }
  .proof-grid > div:last-child strong {
    font-size: 2rem;
    color: var(--text-strong);
  }
  @media (max-width: 760px) {
    .proof-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .proof strong {
      font-size: 2.6rem;
    }
    .proof-grid > div:last-child {
      grid-column: 1/-1;
    }
  }
</style>
