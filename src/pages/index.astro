---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ClientLogoCarousel from '../components/ClientLogoCarousel.astro';
import ServiceCards from '../components/ServiceCards.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CoverageMap from '../components/CoverageMap.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CTASection from '../components/CTASection.astro';
---
<BaseLayout title="Commercial EPCs, SAP, SBEM & Fire Risk Assessments" description="Scottish Energy Services provides practical energy, compliance and fire safety support across Scotland and the UK.">
  <Hero />
  <TrustStrip />
  <ClientLogoCarousel />
  <section class="section"><div class="container" data-reveal><h2 class="section-title">Practical compliance support for residential and non-domestic properties</h2><p class="lead">Scottish Energy Services provides practical energy, compliance and fire safety assessment support for residential and non-domestic properties. From Commercial EPCs and Fire Risk Assessments to SAP, SBEM, Section 63 and DSM support, we help clients meet compliance requirements with clear reporting and dependable communication.</p></div></section>
  <ServiceCards preview={true} />
  <WhyChooseUs />
  <section class="section"><div class="container" data-reveal><h2 class="section-title">Not sure what you need?</h2><ul><li>Selling or leasing a commercial property? You may need a <a href="/commercial-epc-glasgow-scotland">Commercial EPC</a>.</li><li>Working on a new domestic development? You may need <a href="/sap-calculations-scotland">SAP calculations</a>.</li><li>Working on a non-domestic new build or conversion? You may need <a href="/sbem-calculations-scotland">SBEM/BRUKL support</a>.</li><li>Managing shared residential or commercial premises? You may need a <a href="/fire-risk-assessments-scotland">Fire Risk Assessment</a>.</li><li>Selling or leasing a qualifying non-domestic building in Scotland? You may need <a href="/section-63-assessments-scotland">Section 63 support</a>.</li></ul></div></section>
  <ProcessSteps />
  <CoverageMap />
  <FAQAccordion limit={6} />
  <CTASection title="Ready to scope your requirement?" text="Share your building type, project stage, and target date. We will return a clear proposal and available delivery window." button="Request a Quote" />
</BaseLayout>
