---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ProjectsShowcase from '../components/ProjectsShowcase.astro';
import HomeClients from '../components/home/HomeClients.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import PricingSection from '../components/PricingSection.astro';
---

<BaseLayout
  title="Commercial EPCs, SAP, SBEM & Fire Risk Assessments"
  description="Scottish Energy Services provides practical energy, compliance and fire safety support across Scotland and the north of England."
>
  <Hero />

  <ServiceCards>
    <HomeClients slot="clients" compact />
  </ServiceCards>

  <ProjectsShowcase />

  <PricingSection />

  <WhyChooseUs />

  <FAQAccordion limit={6} />
</BaseLayout>
