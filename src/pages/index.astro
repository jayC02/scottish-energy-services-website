---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ProjectsShowcase from '../components/ProjectsShowcase.astro';
import ClientLogoCarousel from '../components/ClientLogoCarousel.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
---

<BaseLayout
  title="Commercial EPCs, SAP, SBEM & Fire Risk Assessments"
  description="Scottish Energy Services provides practical energy, compliance and fire safety support across Scotland and the UK."
>
  <Hero />

  <ServiceCards preview={true} />

  <ProjectsShowcase />

  <ClientLogoCarousel />

  <WhyChooseUs />

  <FAQAccordion limit={6} />
</BaseLayout>
