---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import { sectors } from "../data/sectors";
import { services } from "../data/services";
---

<BaseLayout
  title="Sectors | Commercial Property, Design & Public Estates"
  description="Energy assessments and building compliance support for commercial property, architects, developers, public-sector estates, education and housing."
>
  <section class="page-intro">
    <div class="container">
      <p class="eyebrow">Who we work with</p>
      <h1>
        Different buildings.
        <br />A clear approach.
      </h1>
      <p class="lead">
        Technical assessments shaped around your property, project stage and
        reporting requirements.
      </p>
    </div>
  </section>
  {sectors.map((s, i) => (
    <section
      class:list={["section", { "surface-band": i % 2 === 0 }]}
      id={s.slug}
    >
      <div class="container grid grid-2">
        <div>
          <p class="eyebrow">0{i + 1} / Sector</p>
          <h2>{s.title}</h2>
          <p class="lead">{s.text}</p>
        </div>
        <div>
          <h3>Relevant services</h3>
          <ul class="rule-list">
            {s.services.map((slug) => (
              <li>
                <a href={`/services/${slug}`}>
                  {services.find((s) => s.slug === slug)?.title} ↗
                </a>
              </li>
            ))}
          </ul>
          <a class="text-link" href="/quote">
            Discuss your requirements ↗
          </a>
        </div>
      </div>
    </section>
  ))}
  <CTASection />
</BaseLayout>
