---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { caseStudies, projectServices, type CaseStudy } from '../../data/project-cases';
import { projects } from '../../data/projects';
import { projectImages } from '../../data/project-images';
import { productionSite } from '../../data/seo-routing.mjs';
export function getStaticPaths() { return caseStudies.map(project => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props as { project: CaseStudy };
const media = projects.find(item => item.slug === project.slug);
const image = projectImages[project.slug];
const related = caseStudies.filter(item => item.slug !== project.slug && item.services.some(service => project.services.includes(service))).sort((a,b) => Number(b.sector === project.sector) - Number(a.sector === project.sector)).slice(0,3);
const quoteHref = `/quote?service=${encodeURIComponent(projectServices[project.services[0]].href.split('/').pop()!)}`;
const schema = { '@type': 'CreativeWork', name: project.label, description: project.summary, url: `${productionSite}/projects/${project.slug}`, creator: { '@id': `${productionSite}/#organisation` }, about: project.services.map(key => ({ '@type': 'Service', name: projectServices[key].label, url: `${productionSite}${projectServices[key].href}` })) };
---
<BaseLayout title={project.label} description={project.summary} image={image?.src || media?.poster || '/images/ses-logo-horizontal.png'} imageAlt={image?.alt || project.label} structuredData={schema}>
  <section class="case-intro"><div class="container">
    <nav class="case-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/projects">Projects</a></nav>
    <p class="case-place">{project.location} <span aria-hidden="true">·</span> {project.sector}</p>
    <h1>{project.label}</h1><p class="lead">{project.summary}</p>
  </div></section>
  <section class="case-work"><div class:list={['container','case-layout',{'case-layout--media':Boolean(media || image)}]}>
    {media && <ProjectMedia project={media} priority />}
    {!media && image && <figure class="case-photo">
      <img src={image.src} srcset={image.small ? `${image.small} 640w, ${image.src} ${image.width || 1280}w` : undefined} sizes="(min-width: 801px) 60vw, 92vw" alt={image.alt} width={image.width || 1280} height={image.height || 720} fetchpriority="high" decoding="async" />
      {(image.caption || image.credit) && <figcaption>{image.caption && <span>{image.caption} </span>}{image.credit && <a href={`/photo-credits#${project.slug}`}>Image credit</a>}</figcaption>}
    </figure>}
    <div class="case-scope">
      <h2>What we did</h2><ul class="scope-list">{project.scope.map(item => <li>{item}</li>)}</ul>
      <div class="case-services"><h2>Services</h2><ul>{project.services.map(key => <li><a href={projectServices[key].href}>{projectServices[key].label}<span aria-hidden="true"> ↗</span></a></li>)}</ul></div>
      {project.sites && <div class="case-sites"><h2>{project.slug === 'aldi-stores' ? 'Store locations include' : 'The work includes'}</h2><ul>{project.sites.map(site => <li>{site}</li>)}</ul></div>}
      <a class="btn btn-primary" href={quoteHref}>Discuss a similar project <span aria-hidden="true">↗</span></a>
    </div>
  </div></section>
  <section class="case-related"><div class="container">
    <div class="case-related-heading"><h2>More projects</h2><a href="/projects">View all <span aria-hidden="true">↗</span></a></div>
    <div class="related-grid">{related.map(item => <ProjectCard project={item} compact />)}</div>
  </div></section>
</BaseLayout>
<script>import '../../scripts/project-page.js';</script>
<style>
  .case-intro{background:var(--surface-soft);padding:2rem 0 2.5rem;border-bottom:1px solid var(--border)}
  .case-breadcrumb{display:flex;gap:.6rem;font-size:.8rem;color:var(--muted);margin-bottom:1.8rem}.case-breadcrumb a{text-decoration:underline;text-underline-offset:3px}
  .case-place{color:var(--brand-strong);font-size:.85rem;margin:0 0 .7rem}.case-place span{margin:0 .3rem}
  h1{color:var(--text-strong);font-size:clamp(2rem,4.5vw,3.6rem);letter-spacing:-.035em;line-height:1.12;max-width:25ch;margin:0}.case-intro .lead{margin:.9rem 0 0;max-width:62ch}
  .case-work{padding:2.5rem 0}.case-layout{max-width:850px}.case-layout--media{max-width:var(--max);display:grid;grid-template-columns:1.3fr 1fr;gap:2.5rem;align-items:start}
  .case-photo{margin:0;min-width:0}.case-photo img{width:100%;height:auto;aspect-ratio:8/5;object-fit:cover;border-radius:12px}.case-photo figcaption{margin-top:.5rem;font-size:.72rem;color:var(--muted)}.case-photo figcaption a{text-decoration:underline;text-underline-offset:3px}
  h2{color:var(--text-strong);font-size:1.15rem;line-height:1.3;margin:0 0 .85rem}.scope-list{padding-left:1.1rem;color:var(--muted);margin:0 0 1.5rem}.scope-list li+li{margin-top:.5rem}
  .case-services{border-top:1px solid var(--border);padding-top:1.25rem;margin-bottom:1.5rem}.case-services ul{display:flex;flex-wrap:wrap;gap:.5rem 1.25rem;list-style:none;padding:0;margin:0}.case-services a{color:var(--brand-strong);font-size:.92rem;text-decoration:underline;text-underline-offset:4px}
  .case-sites{border-top:1px solid var(--border);padding-top:1.25rem;margin-bottom:1.5rem}.case-sites ul{margin:0;padding-left:1.1rem;columns:2;column-gap:2rem;color:var(--muted);font-size:.92rem}.case-sites li{break-inside:avoid;margin-bottom:.4rem}
  .case-related{padding:2rem 0 3rem;background:var(--surface-soft);border-top:1px solid var(--border)}.case-related-heading{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;margin-bottom:1rem}.case-related-heading h2{margin:0}.case-related-heading>a{font-size:.85rem;color:var(--brand-strong)}
  .related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
  @media(max-width:800px){.case-layout--media{grid-template-columns:1fr;gap:1.8rem}.related-grid{grid-template-columns:1fr}}
  @media(max-width:480px){.case-sites ul{columns:1}}
</style>
