---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projectImages } from '../data/project-images';
import { siteConfig } from '../data/site';
const hero = projectImages['theatre-royal-glasgow'];
const gallery = projectImages['kelvingrove-art-gallery'];
const phoneHref = `tel:${siteConfig.phone.replace(/\s+/g, '')}`;
const examples = [
  { name: 'Glasgow Life', href: '/projects/glasgow-life', work: 'Commercial EPCs across museums, cultural venues and leisure facilities.' },
  { name: 'Vita Edinburgh', href: '/projects/vita-edinburgh', work: 'SBEM calculations for student accommodation at Fountainbridge.' },
  { name: 'Moda Springside', href: '/projects/moda-springside', work: 'SAP calculations and EPC work for the residential development.' }
];
---
<BaseLayout title="About Scottish Energy Services" description="Around 15 years of energy assessment work from Glasgow. Meet SES and explore our services, project experience and energy assessor accreditation.">
  <section class="about-intro"><div class="container about-intro-layout">
    <div class="about-intro-copy">
      <h1>About SES</h1>
      <p class="about-lead">Energy assessments, from design to completion.</p>
      <p>Scottish Energy Services has been carrying out energy assessments for around 15 years. Based in Glasgow, we work with architects, developers, landlords, managing agents and estates teams across Scotland and the wider UK.</p>
      <p>Our work ranges from individual properties to major venues, developments and portfolios. We also help homeowners with domestic EPCs and property assessments.</p>
      <a class="about-text-link" href="/services">Explore our services <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
    </div>
    <figure class="about-photo about-hero-photo">
      <img src={hero.src} srcset={`${hero.small} 640w, ${hero.src} ${hero.width}w`} sizes="(min-width: 801px) 46vw, 92vw" width={hero.width} height={hero.height} alt={hero.alt} fetchpriority="high" decoding="async" />
      <figcaption><a href="/projects/theatre-royal-glasgow">Theatre Royal Glasgow. Commercial EPC work.</a></figcaption>
    </figure>
  </div></section>

  <section class="about-work"><div class="container about-work-layout">
    <figure class="about-photo about-work-photo">
      <img src={gallery.src} srcset={`${gallery.small} 640w, ${gallery.src} 1280w`} sizes="(min-width: 801px) 46vw, 92vw" width="1280" height="720" alt="Kelvingrove Art Gallery and Museum in Glasgow" loading="lazy" decoding="async" />
      <figcaption><a href="/projects/kelvingrove-art-gallery">Kelvingrove Art Gallery and Museum. Commercial EPC work.</a></figcaption>
    </figure>
    <div class="about-work-copy">
      <h2>Buildings you’ll recognise</h2>
      <p>Our commercial EPC projects include Glasgow Airport, the SEC Armadillo and Kelvingrove Art Gallery. We also work on student accommodation, retail premises, hotels and residential developments.</p>
      <dl class="about-project-list">{examples.map(example => <div>
        <dt><a href={example.href}>{example.name} <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a></dt>
        <dd>{example.work}</dd>
      </div>)}</dl>
      <a class="about-text-link" href="/projects">See our projects <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
    </div>
  </div></section>

  <section class="about-practice"><div class="container about-practice-layout">
    <div>
      <h2>Accredited energy assessors</h2>
      <p>Our energy assessors are accredited through Elmhurst Energy and ecmk. The schemes provide quality checks, technical support and certificate lodgement.</p>
      <p>Our energy assessment work covers domestic and commercial EPCs, new build assessments, Display Energy Certificates and Section 63.</p>
      <div class="about-accreditation" aria-label="Energy assessor accreditation schemes">
        <a href="https://www.elmhurstenergy.co.uk/join/" aria-label="Elmhurst Energy accreditation"><img src="/images/accreditation/elmhurst-energy.png" alt="Elmhurst Energy" width="200" height="70" loading="lazy" decoding="async" /></a>
        <a href="https://www.ecmk.co.uk/accreditation/" aria-label="ecmk accreditation"><img src="/images/accreditation/ecmk.svg" alt="ecmk" width="120" height="55" loading="lazy" decoding="async" /></a>
      </div>
    </div>
    <div class="about-working">
      <h2>Working with your team</h2>
      <p>We provide SAP, SBEM, EPCs, Section 63, DECs, overheating assessments, building modelling, fire risk assessments and Legionella risk assessments.</p>
      <dl class="about-process">
        <div><dt>Scope and fees</dt><dd>We agree what’s needed and the full fee before work begins.</dd></div>
        <div><dt>Visits and delivery</dt><dd>We arrange access, drawings and delivery dates with your team.</dd></div>
        <div><dt>Reports and next steps</dt><dd>You receive the agreed calculations, certificates or assessment report, with advice on what comes next.</dd></div>
      </dl>
    </div>
  </div></section>

  <section class="about-contact"><div class="container about-contact-layout">
    <div><h2>Talk to SES</h2><p>Tell us the property, service and deadline. We’ll confirm the scope and fee.</p><p class="about-contact-details"><a href={phoneHref} data-track="phone_click">{siteConfig.phone}</a><a href={`mailto:${siteConfig.email}`} data-track="email_click">{siteConfig.email}</a></p></div>
    <a class="btn btn-primary" href="/quote">Request a quote</a>
  </div></section>
</BaseLayout>
<style>
  .about-intro{padding:3rem 0 3.5rem;background:white}.about-intro-layout{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,4.5rem);align-items:center}
  h1{margin:0 0 1.1rem;color:var(--text-strong);font-size:clamp(2.1rem,4vw,3.2rem);line-height:1.1;letter-spacing:-.03em}
  h2{margin:0 0 1rem;font-size:clamp(1.5rem,2.6vw,2rem);line-height:1.2;letter-spacing:-.025em;color:var(--text-strong)}
  p{color:var(--muted);margin:0 0 1rem;font-size:.96rem;line-height:1.75;max-width:64ch}
  .about-lead{color:var(--text-strong);font-size:clamp(1.2rem,2vw,1.5rem);line-height:1.4;max-width:30ch;margin-bottom:1.25rem}
  .about-photo{margin:0;min-width:0}.about-photo img{width:100%;object-fit:cover;border-radius:12px}.about-hero-photo img{height:410px;object-position:50% 45%}.about-photo figcaption{margin-top:.7rem;color:var(--muted);font-size:.72rem;line-height:1.5}.about-photo figcaption a:hover{color:var(--brand-strong);text-decoration:underline;text-underline-offset:3px}
  .about-text-link{display:inline-flex;align-items:center;gap:12px;min-height:44px;font-size:.9rem;font-weight:650;color:var(--brand-strong)}.about-text-link svg{transition:transform .2s ease}.about-text-link:hover svg{transform:translateX(3px)}
  .about-work{padding:3rem 0;background:#f5f8fb}.about-work-layout{display:grid;grid-template-columns:1.08fr 1fr;gap:clamp(2rem,5vw,4.5rem);align-items:center}.about-work-photo img{height:420px;object-position:50% 45%}
  .about-project-list{margin:1.25rem 0 .5rem}.about-project-list>div{padding:.85rem 0;border-top:1px solid var(--border)}.about-project-list dt{font-weight:650;font-size:.95rem;color:var(--text-strong)}.about-project-list dt a{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:28px}.about-project-list dt a:hover{color:var(--brand-strong)}.about-project-list dd{margin:.2rem 0 0;font-size:.84rem;line-height:1.6;color:var(--muted)}
  .about-practice{padding:3.5rem 0;background:white}.about-practice-layout{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,4.5rem)}.about-working{border-left:1px solid var(--border);padding-left:clamp(1.5rem,3vw,3rem)}
  .about-accreditation{display:flex;align-items:center;flex-wrap:wrap;gap:2rem;margin-top:2rem}.about-accreditation a{display:grid;place-items:center;min-height:64px}.about-accreditation img{object-fit:contain;max-height:60px;width:auto;max-width:190px}.about-accreditation a:last-child img{max-width:105px;height:48px}
  .about-process{margin:1.2rem 0 0}.about-process>div+div{margin-top:1rem}.about-process dt{font-size:.9rem;color:var(--text-strong);font-weight:650}.about-process dd{margin:.25rem 0 0;color:var(--muted);font-size:.86rem;line-height:1.6}
  .about-contact{padding:2.5rem 0;background:#f5f8fb;border-top:1px solid var(--border)}.about-contact-layout{display:flex;justify-content:space-between;align-items:center;gap:2rem}.about-contact h2{margin-bottom:.6rem}.about-contact p{margin:0}.about-contact-details{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;padding-top:.9rem;font-size:.85rem}.about-contact-details a{text-decoration:underline;text-underline-offset:3px;color:var(--brand-strong)}.about-contact .btn{flex:none}
  @media(max-width:800px){.about-intro-layout,.about-work-layout,.about-practice-layout{grid-template-columns:1fr;gap:2rem}.about-intro{padding:2rem 0}.about-hero-photo img{height:330px}.about-work-photo{order:2}.about-work-photo img{height:300px}.about-working{padding:2rem 0 0;border-left:0;border-top:1px solid var(--border)}.about-practice{padding:2.5rem 0}.about-contact-layout{display:block}.about-contact .btn{margin-top:1.4rem}}
  @media(max-width:400px){.about-hero-photo img{height:275px}.about-work-photo img{height:240px}.about-accreditation{gap:1.4rem}.about-accreditation img{max-width:165px}.about-accreditation a:last-child img{max-width:85px}}
  @media(prefers-reduced-motion:reduce){.about-text-link svg{transition:none}.about-text-link:hover svg{transform:none}}
</style>
