---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
---
<BaseLayout title="Glasgow, Edinburgh & UK Service Coverage" description="Energy assessment coverage from Glasgow across Edinburgh, the Central Belt and wider Scotland. Contact SES to confirm survey availability for your site.">
  <section class="section">
    <div class="container" data-reveal>
      <h1 class="section-title">UK coverage</h1>
      <p class="lead">Based in Glasgow, we support projects across the UK. Send your postcode and service to check availability.</p>
    </div>
  </section>
  <section class="section" style="padding-top:0">
    <div class="container grid grid-3">
      <article class="card" data-reveal><h2>Scotland</h2><p>Surveys across the Central Belt, Highlands and regional towns.</p></article>
      <article class="card" data-reveal><h2>England and Wales</h2><p>Appointments for individual properties and portfolios.</p></article>
      <article class="card" data-reveal><h2>Northern Ireland</h2><p>Contact us to arrange a survey and confirm the timescale.</p></article>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>Planning your assessment</h2>
      <p>For <a href="/services/commercial-epcs">commercial EPCs</a> and <a href="/services/section-63-assessments">Section 63</a>, send the address, floor area, access details and deadline.</p>
      <p>For <a href="/services/saps">SAP</a> and <a href="/services/sbem-calculations">SBEM</a>, send drawings and specifications. We’ll confirm the requirements for your location.</p>
      <p>Our contact address is 272 Bath St, Glasgow, G2 4JR. <a href="/contact">Contact SES to confirm availability</a>.</p>
    </div>
  </section>
  <CTASection title="Check availability" text="Send your postcode and the service you need." />
</BaseLayout>
