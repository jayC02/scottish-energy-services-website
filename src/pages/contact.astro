---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
const phoneHref = `tel:${siteConfig.phone.replace(/\s+/g, '')}`;
import QuoteRequestForm from '../components/QuoteRequestForm.astro';
---
<BaseLayout title="Contact" description="Contact Scottish Energy Services for technical enquiries, quotes, and appointment availability.">
  <section class="section">
    <div class="container grid grid-2">
      <div data-reveal>
        <p class="eyebrow">Contact</p>
        <h1 class="section-title">Talk to our team</h1>
        <p class="lead">For the quickest quote, please include the property address, service required, project stage and any drawings/specifications available. We will confirm scope, fee and likely timescale before instruction.</p>
        <div class="contact-card card"><p><strong>Phone:</strong> <a href={phoneHref} data-track="phone_click">{siteConfig.phone}</a></p><p><strong>Email:</strong> <a href={`mailto:${siteConfig.email}`} data-track="email_click">{siteConfig.email}</a></p></div>
      </div>
      <QuoteRequestForm formType="contact" submitText="Send enquiry" reveal={true} />
    </div>
  </section>
</BaseLayout>
