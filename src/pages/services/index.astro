---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import { siteConfig, turnaroundPromise } from '../../data/site';
const phoneHref = `tel:${siteConfig.phone.replace(/\s+/g, '')}`;
---
<BaseLayout title="Energy & Building Compliance Services Scotland" description="Commercial EPCs, Section 63, SAP, SBEM, DSM, TM59, DECs and fire risk assessments from Glasgow, with reports within 48 hours of the site visit across Scotland and the UK.">
  <ServiceCards page />
  <section class="service-help">
    <div class="container">
      <div class="service-help__panel" data-animate="scale">
        <span class="service-help__block" aria-hidden="true"></span>
        <div class="service-help__copy">
          <h2>Not sure which assessment you need?</h2>
          <p>Send the address, project stage and any drawings. We’ll confirm the right assessment, a fixed fee, and your report within {turnaroundPromise.hours} hours of our visit.</p>
        </div>
        <div class="service-help__actions">
          <a class="service-help__btn service-help__btn--mint" href="/quote">Discuss your project <span aria-hidden="true">→</span></a>
          <a class="service-help__btn" href={phoneHref}>Call {siteConfig.phone}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .service-help { padding: 0 0 clamp(4rem, 8vw, 6rem); background: #fff; }
  .service-help__panel { position: relative; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1.2fr) auto; gap: 2rem 3rem; align-items: center; padding: clamp(2rem, 5vw, 3.4rem); border-radius: 6px; background: linear-gradient(120deg, var(--navy), var(--navy-2)); color: #fff; }
  .service-help__block { position: absolute; right: -40px; top: -40px; width: 200px; height: 200px; background: var(--mint); opacity: .12; transform: rotate(16deg); }
  .service-help__copy, .service-help__actions { position: relative; }
  h2 { margin: 0; max-width: 20ch; color: #fff; font-size: clamp(1.7rem, 3.2vw, 2.5rem); font-weight: 800; line-height: 1.1; letter-spacing: -.04em; }
  p { max-width: 58ch; margin: 1rem 0 0; color: #c2d2df; line-height: 1.6; }
  .service-help__actions { display: flex; flex-direction: column; gap: .7rem; }
  .service-help__btn { display: inline-flex; align-items: center; justify-content: center; gap: .6rem; min-height: 50px; padding: .85rem 1.4rem; border: 1px solid rgba(255, 255, 255, .3); border-radius: 999px; color: #fff; font-weight: 750; white-space: nowrap; transition: transform .35s var(--ease-out), background-color .25s ease, border-color .25s ease; }
  .service-help__btn:hover { transform: translateY(-2px); border-color: #fff; }
  .service-help__btn--mint { border-color: transparent; background: linear-gradient(120deg, var(--brand-bright), var(--brand)); color: #fff; }
  .service-help__btn--mint:hover { filter: brightness(1.08); border-color: transparent; }
  @media (max-width: 820px) { .service-help__panel { grid-template-columns: 1fr; } .service-help__actions { flex-direction: row; flex-wrap: wrap; } }
  @media (max-width: 520px) { .service-help__btn { width: 100%; } }
</style>
