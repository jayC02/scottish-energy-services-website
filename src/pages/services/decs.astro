---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceDetail from '../../components/ServiceDetail.astro';
import { getServicePage } from '../../data/service-pages';
const { service, detail, schema } = getServicePage('decs');
---
<BaseLayout title={detail.title} description={detail.description} structuredData={schema}>
  <ServiceDetail service={service} />
</BaseLayout>
